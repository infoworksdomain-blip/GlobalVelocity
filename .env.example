# ---- Core ----
APP_NAME=Velocity
APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000/api/auth
DATABASE_URL=postgres://velocity:velocity@localhost:5432/velocity
REDIS_URL=redis://localhost:6379
AUTH_SECRET=change-me-32-chars-minimum-random-string
# ---- Auth providers (optional; magic link always available) ----
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
EMAIL_FROM=login@example.com
RESEND_API_KEY=            # empty = magic links are printed to the server log (dev)
# ---- Storage: STORAGE_DRIVER=local (files under .media, served at /media/*) or s3 (below; MinIO in docker-compose) ----
STORAGE_DRIVER=s3
LOCAL_STORAGE_DIR=
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=velocity-media
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_PUBLIC_URL=http://localhost:9000/velocity-media
# ---- AI providers ----
PROVIDER_MODE=mock          # mock | live  (mock runs the whole loop without any external keys)
LLM_PROVIDER=openai         # openai | anthropic -- primary provider; completeJson() automatically falls back to the other if the primary errors and a key is set for it
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
FIRECRAWL_API_KEY=
ELEVENLABS_API_KEY=
VIDEO_PROVIDER_URL=         # HTTP endpoint implementing the TalkingHeadProvider contract (see src/lib/render/index.ts); e.g. https://<app>.onrender.com/api/internal/video-provider/falai or .../heygen
VIDEO_PROVIDER_KEY=
FALAI_VIDEO_MODEL=fal-ai/kling-video/ai-avatar/v2/standard   # used by the falai video-provider route; swap to .../pro for higher quality
IMAGE_PROVIDER_URL=         # e.g. https://fal.run/fal-ai/flux-pro (any endpoint accepting {prompt,image_url} → {images:[{url}]})
IMAGE_PROVIDER_KEY=
METRICS_FIRST_PULL_DELAY_MS=3600000
WORKER_ROLE=all             # all | core | render -- run "all" queues+schedulers here, or split render/ingest onto a separate host (e.g. Railway) via railway.worker.json
CORE_CONCURRENCY=8
WORKER_CONCURRENCY=3
INGEST_CONCURRENCY=4
# ---- Social platforms (required for live publishing) ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
GOOGLE_YT_CLIENT_ID=
GOOGLE_YT_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=        # 32-byte hex; openssl rand -hex 32
# ---- Billing ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTH=
STRIPE_PRICE_STARTER_YEAR=
STRIPE_PRICE_GROWTH_MONTH=
STRIPE_PRICE_GROWTH_YEAR=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
# ---- Misc ----
DISCORD_INVITE_URL=https://discord.gg/your-invite
ADMIN_EMAILS=you@example.com
ALLOW_HTTP_WEBHOOKS=0
